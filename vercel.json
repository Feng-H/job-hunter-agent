{
  "version": 2,
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/entry" },
    { "source": "/auth/(.*)", "destination": "/api/entry" },
    { "source": "/healthz", "destination": "/api/entry" },
    { "source": "/demo", "destination": "/index.html" }
  ]
}
