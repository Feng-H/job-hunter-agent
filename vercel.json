{
  "version": 2,
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "/api/auth/$1"
    },
    {
      "source": "/healthz",
      "destination": "/api/healthz"
    },
    {
      "source": "/demo",
      "destination": "/index.html"
    }
  ]
}
