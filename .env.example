# ========================================================
# Job-Hunter OS 环境配置模板
# 复制本文件为 .env 并填入你自己的配置
# ========================================================

# 1. 大语言模型（LLM）配置（仅真实管理员可使用，兼容 OpenAI 规范：DeepSeek, Claude, GLM, Qwen 等）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# 2. 飞书自定义机器人 Webhook 与凭证（用于接收岗位推荐卡片与一键决策）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Vercel 云端持久化存储（Vercel KV / Upstash Redis）
# 在 Vercel 控制台创建 Storage -> KV，系统将自动注入以下两个环境变量：
KV_REST_API_URL=https://xxxx.upstash.io
KV_REST_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 4. Web 看板服务本地监听端口（本地运行使用）
PORT=8765
